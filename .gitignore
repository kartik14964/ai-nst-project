# Ignore macOS system files
.DS_Store
**/.DS_Store

# Ignore Python bytecode directories
__pycache__/
**/__pycache__/
*.pyc

# Virtual environments
venv/
.venv/
env/

# Gradio cache
.gradio/

# Ignore runtime user uploads in static/uploads
frontend/static/uploads/*
!frontend/static/uploads/.gitkeep
